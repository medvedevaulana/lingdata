    <TIER ANNOTATOR="Ulyana" LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@uvm2008f" PARTICIPANT="@uvm2008f" TIER_ID="gestComment@uvm2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>как выражение отрицания, недоумения(..ничего необычного не происходит...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a316">
                <ANNOTATION_VALUE>ритм речи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3403" ANNOTATION_REF="a3395">
                <ANNOTATION_VALUE>представление нового варианта с помощью фразы "либо"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3404" ANNOTATION_REF="a3396">
                <ANNOTATION_VALUE>прагматический, потому что показывает отношение к высказыванию, указывает на сарказм</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3421" ANNOTATION_REF="a3405">
                <ANNOTATION_VALUE>представление нового варианта с помощью слова "либо", это подчеркивается движением ноги</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>выделение важных слов</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a563" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>выделение важной мысли(...самых необычных...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a649" ANNOTATION_REF="a567">
                <ANNOTATION_VALUE>указание на "то" необычное, введение новой темы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a595" ANNOTATION_REF="a587">
                <ANNOTATION_VALUE>подтверждение, одобрение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a606" ANNOTATION_REF="a601">
                <ANNOTATION_VALUE>неуверенность</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3433" ANNOTATION_REF="a2965">
                <ANNOTATION_VALUE>неуверенность подчеркивается словом "возможно"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2986" ANNOTATION_REF="a2966">
                <ANNOTATION_VALUE>указываю на Тасю ("ты меня сейчас об этом спрашивала...")</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3434" ANNOTATION_REF="a2988">
                <ANNOTATION_VALUE>показывает отношение к высказыванию: испытывать стыд из-за описываемых действий</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3024" ANNOTATION_REF="a3003">
                <ANNOTATION_VALUE>в значении "с этим ничего не поделаешь"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3070" ANNOTATION_REF="a3058">
                <ANNOTATION_VALUE>мотание головой, как отрицание и неуверенность(=наверное ничего из раннего детства назвать не смогу)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
